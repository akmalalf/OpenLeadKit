APP_NAME=OpenLeadKit
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_PROJECT_URL=https://github.com/akmalalf/OpenLeadKit

# Replace CHANGE_ME only in your local `.env`. Never store real passwords in this example file.
DATABASE_URL=postgresql+psycopg://openleadkit_app:CHANGE_ME@127.0.0.1:5432/openleadkit
TEST_DATABASE_URL=postgresql+psycopg://openleadkit_app:CHANGE_ME@127.0.0.1:5432/openleadkit_test

OVERPASS_API_URL=https://overpass-api.de/api/interpreter
NOMINATIM_API_URL=https://nominatim.openstreetmap.org

HTTP_USER_AGENT=OpenLeadKit/0.1.0
HTTP_CONNECT_TIMEOUT_SECONDS=10
HTTP_READ_TIMEOUT_SECONDS=30
HTTP_MAX_RESPONSE_BYTES=5000000
HTTP_PER_DOMAIN_DELAY_SECONDS=2

DEFAULT_RESULT_LIMIT=100
MAX_RESULT_LIMIT=500
DUPLICATE_NAME_THRESHOLD=0.72

# Optional custom CRM workbook. If it is absent, OpenLeadKit generates a new XLSX workbook.
EXCEL_INPUT_PATH=input/Website_Lead_Funnel_CRM.xlsx
EXCEL_OUTPUT_DIR=exports
